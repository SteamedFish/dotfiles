// Override only what differs from opencode-acp defaults — everything
// else inherits from the plugin. See:
// https://github.com/ranxianglei/opencode-acp
//
// 压缩策略（2026-09-11 起）：
// - 默认面向 1M 窗口模型：实测超过 50% 后输出质量下降，因此 40% 起
//   提醒（turn/iteration/growth 三类 nudge），50% 起强 nudge，目标是把
//   上下文稳定压在 50% 以内。
// - 注意 minContextLimit 只管 turn/iteration 提醒；growth nudge 的地板
//   是 minNudgeContextPercent（默认 5%，曾在 5.6% 用量就触发压缩）。
// - kimi-k3-256k / gpt-5.6-luna / qwen3.8-27b(-cuda) 实测满窗口质量仍可
//   保障（qwen3.8-27b 窗口仅 131072），对它们只需避免溢出 100%：90% 起
//   提醒、95% 强 nudge，全局默认的 emergencyThresholdPercent=98% 兜底
//   强制压缩（该键不支持按模型覆盖）。
// - modelMinLimits 已被官方标记弃用，迁移至 compress.providers。
{
    "$schema": "https://raw.githubusercontent.com/ranxianglei/opencode-acp/master/dcp.schema.json",
    "compress": {
        "maxContextLimit": "50%",
        "minContextLimit": "40%",
        "minNudgeContextPercent": 40,
        "providers": {
            "litellm": {
                "models": {
                    "kimi-k3-256k": {
                        "maxContextLimit": "95%",
                        "minContextLimit": "90%",
                        "minNudgeContextPercent": 90
                    },
                    "locez/gpt-5.6-luna": {
                        "maxContextLimit": "95%",
                        "minContextLimit": "90%",
                        "minNudgeContextPercent": 90
                    },
                    "strix/qwen3.8-27b": {
                        "maxContextLimit": "95%",
                        "minContextLimit": "90%",
                        "minNudgeContextPercent": 90
                    },
                    "strix/qwen3.8-27b-cuda": {
                        "maxContextLimit": "95%",
                        "minContextLimit": "90%",
                        "minNudgeContextPercent": 90
                    }
                }
            }
        }
    }
}
