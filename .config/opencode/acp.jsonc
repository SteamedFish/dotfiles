// Override only what differs from opencode-acp defaults — everything
// else inherits from the plugin. See:
// https://github.com/ranxianglei/opencode-acp
//
// 压缩策略（2026-09-11 起）：
// - 默认面向 1M 窗口模型：实测超过 50% 后输出质量下降，因此 40% 起
//   提醒（turn/iteration/growth 三类 nudge），50% 起强 nudge，目标是把
//   上下文稳定压在 50% 以内。
// - 注意 minContextLimit 只管 turn/iteration 提醒；growth nudge 的地板
//   是 minNudgeContextPercent（默认 5%，曾在 5.6% 用量就触发压缩）。
// - kimi-k3-256k / gpt-5.6-luna（256K 窗口）实测满窗口质量仍可保障：
//   90% 起提醒、95% 强 nudge，全局默认 emergencyThresholdPercent=98%
//   兜底（该键不支持按模型覆盖）。
// - strix/qwen3.8-27b(-cuda)（131K 窗口）同样满窗口质量好，但小窗口
//   必须更早开始压缩：preserveRecentMessages 按消息条数保护（默认 5）
//   不看大小，若 90% 才起步，尾部几条大文件读取即可吞掉整个窗口，
//   导致 98% 时"压缩已耗尽"（2026-09-11 实测发生）。故 70% 起提醒、
//   85% 强 nudge。
// - 所有满窗口模型统一 preserveRecentMessages: 2，拆掉尾部巨消息
//   吞窗的洞。
// - modelMinLimits 已被官方标记弃用，迁移至 compress.providers。
{
    "$schema": "https://raw.githubusercontent.com/ranxianglei/opencode-acp/master/dcp.schema.json",
    "compress": {
        "maxContextLimit": "50%",
        "minContextLimit": "40%",
        "minNudgeContextPercent": 40,
        "providers": {
            "litellm": {
                "models": {
                    "kimi-k3-256k": {
                        "maxContextLimit": "95%",
                        "minContextLimit": "90%",
                        "minNudgeContextPercent": 90,
                        "preserveRecentMessages": 2
                    },
                    "locez/gpt-5.6-luna": {
                        "maxContextLimit": "95%",
                        "minContextLimit": "90%",
                        "minNudgeContextPercent": 90,
                        "preserveRecentMessages": 2
                    },
                    "strix/qwen3.8-27b": {
                        "maxContextLimit": "85%",
                        "minContextLimit": "70%",
                        "minNudgeContextPercent": 70,
                        "preserveRecentMessages": 2,
                        "preserveRecentTokens": 3000
                    },
                    "strix/qwen3.8-27b-cuda": {
                        "maxContextLimit": "85%",
                        "minContextLimit": "70%",
                        "minNudgeContextPercent": 70,
                        "preserveRecentMessages": 2,
                        "preserveRecentTokens": 3000
                    }
                }
            }
        }
    }
}
