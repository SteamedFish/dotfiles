#!/bin/bash -e

set -o pipefail
set -u
set -E

cd "$HOME"

# Color definitions
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly RESET='\033[0m'

# Helper functions for colored output
print_success() {
    echo -e "${GREEN}✓${RESET} $*"
}

print_error() {
    echo -e "${RED}✗${RESET} $*" >&2
}

print_status() {
    echo -e "${BLUE}→${RESET} $*"
}

print_info() {
    echo -e "${CYAN}ℹ${RESET} $*"
}

print_header() {
    echo -e "\n${BOLD}${BLUE}═══ $* ═══${RESET}\n"
}

# Summary tracking
declare -a UPDATE_SUCCESS=()
declare -a UPDATE_FAILED=()

# Track update result
track_update() {
    local component="$1"
    local status="$2"  # 0=success, non-zero=failure
    
    if [ "$status" -eq 0 ]; then
        UPDATE_SUCCESS+=("$component")
    else
        UPDATE_FAILED+=("$component")
    fi
}

run() {
    # execute any programs
    # -r, --retry    retry time when execute fail. default 0
    # -n, --dry-run  perform a trial run with no changes made
    # example: run -r 3 df -h
    # WARNING: any unrecognized option will be treated as command.
    # for example, `run -n 3' will execute `3' with dry-run option.

    local retry=0
    local dry_run=false
    local retcode

    if getopt -T; then
        echo "You are using old style getopt" >&2
        exit 1
    fi

    local params
    params="$(getopt -n run -o '+r:n' -l 'retry:,dry-run' -- "$@")"
    if ! eval set -- "$params"; then
        echo "Incorrect options provided to $0"
        cat <<EOF
run: execute any programs
    -r, --retry    retry time when execute fail. default 0
    -n, --dry-run  perform a trial run with no changes made

    example: run -r 3 -l somefile.log df -h
EOF
        exit 1
    fi

    while true; do
        case "$1" in
        -r | --retry)
            retry=$2
            shift 2
            ;;
        -n | --dry-run)
            dry_run=true
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Unrecognized Options" >&2
            exit 1
            ;;
        esac
    done

    print_status "$(date "+%F %T") RUNNING: $*"
    
    while true; do
        if $dry_run; then
            print_info "DRY-RUN: $*"
            return 0
        fi

        set +e
        "$@"
        retcode="$?"
        set -e

        if [ "$retcode" -eq 0 ]; then
            print_success "$(date "+%F %T") $*"
            return "$retcode"
        fi

        print_error "$(date "+%F %T") Failed: $*"

        retry=$((retry - 1))

        if [ "$retry" -le 0 ]; then
            print_error "No more retries - $* failed!"
            #return "$retcode"
            return 0
        fi

        echo -e "${YELLOW}⟳${RESET} Retries left: $retry"

    done

    # should never go here
    echo "Internal Error!" >&2
    exit 2
}

gitpull() {
    if [ -d .git ]; then
        local repo_name
        repo_name="$(basename "$(pwd)")"
        print_info "Pulling ${CYAN}${repo_name}${RESET}"
        run git reset --hard origin/master
        run -r 5 git pull
        run -r 5 git submodule update --recursive --init
    fi
}

get_sudo() {
    if [ -z "$(command -v sudo)" ]; then
        return
    fi
    echo "please input sudo password"
    sudo -v
    while true; do
        # sudo gives access for 300 seconds
        sleep 290
        sudo -v
    done &
}

update_context() {
    echo "updating ConTeXt"
    _POSSIBLE_PATH="/Volumes/DATA/ConTeXt /Volumes/MacData/ConTeXt /Volumes/SteamedFish/ConTeXt $HOME/ConTeXt"
    for _CONTEXT_PATH in ${_POSSIBLE_PATH}; do
        if [ -d "${_CONTEXT_PATH}" ]; then
            cd "${_CONTEXT_PATH}"
            run rsync -av rsync://contextgarden.net/minimals/setup/first-setup.sh .
            run bash first-setup.sh --modules=all
            run mtxrun --scripts fonts --reload
        fi
    done
    unset _POSSIBLE_PATH
    unset _CONTEXT_PATH
}

update_mac_system() {
    if [ -n "$(command -v softwareupdate)" ]; then
        echo "updating mac system"
        run sudo softwareupdate -i -a
    fi
}

update_linux_system() {
    local PACMAN_CMD
    if [[ -f /etc/arch-release ]]; then
        if [ -n "$(command -v yay)" ]; then
            PACMAN_CMD="yay"
            run yay -Y --gendb
        else
            PACMAN_CMD="sudo pacman"
        fi

        run "${PACMAN_CMD}" -Fy
        run "${PACMAN_CMD}" -Syu
        #run "${PACMAN_CMD}" -Yc

        #if [ -n "$(command -v pikaur)" ]; then
        #    # update git packages
        #    run pikaur -Sua --devel --needed
        #fi
        if [ -n "$(command -v pacdiff)" ]; then
            run sudo pacdiff # pacman-contrib
        elif [ -n "$(command -v etc-update)" ]; then
            run sudo etc-update
        fi
        # run "${PACMAN_CMD}" -Scc --noconfirm
        # this will exit with SIGPIPE error, we pass a true here
        yes | run "${PACMAN_CMD}" -Scc || true
    elif [[ -f /etc/debian_version ]]; then
        run sudo apt update
        run sudo apt upgrade
        run sudo apt autoremove
        run sudo apt clean
    elif [[ -f /etc/gentoo-release ]]; then
        if [ -n "$(command -v layman)" ]; then
            run -r 5 sudo layman -S
        fi
        if [ -n "$(command -v eix-sync)" ]; then
            run -r 5 sudo eix-sync
        else
            run -r 5 sudo emerge --sync
        fi
        run sudo emerge -avuUD --with-bdeps=y --keep-going --quiet-build @world
        run sudo emerge -av --keep-going --quiet-build @preserved-rebuild
        if [ -n "$(command -v haskell-updater)" ]; then
            run sudo haskell-updater
        fi
        if [ -n "$(command -v qlop)" ]; then
            run qlop -tHmvl
        fi
        if [ -n "$(command -v smart-live-rebuild)" ]; then
            run -r 5 sudo smart-live-rebuild
        fi
        run sudo emerge -avc --exclude="sys-kernel/gentoo-sources"
        if [ -n "$(command -v eclean-kernel)" ]; then
            # keep only 3 recent kernels
            run sudo eclean-kernel -A -n 3
        fi
        if [ -n "$(command -v eclean)" ]; then
            run sudo eclean -d distfiles
            run sudo eclean -d packages
        fi
    elif [[ -f /etc/redhat-release ]]; then
        run sudo dnf update
        run sudo dnf upgrade
        run sudo dnf autoremove
        run sudo dnf clean all
    elif [[ $(uname -o) == "Android" ]]; then
        run apt update
        run apt upgrade
        run pkg upgrade
    fi
    if [ -n "$(command -v snap)" ]; then
        run sudo snap refresh
    fi
    if [ -n "$(command -v flatpak)" ]; then
        run flatpak update
    fi
    if [ -n "$(command -v kbuildsycoca5)" ]; then
        # update kde menu cache
        run kbuildsycoca5
    fi
}

update_zsh() {
    if [ -f "$HOME/.zinit/bin/zinit.zsh" ]; then
        cd "$HOME/.zinit/bin" && gitpull
        run zsh -c "source $HOME/.zinit/bin/zinit.zsh; zinit self-update; zinit update --all"
    fi
}

update_mas() {
    if [ -n "$(command -v mas)" ]; then
        echo "updating mac appstore"
        run mas outdated
        run mas upgrade
    fi
}

update_homebrew() {
    if [ -n "$(command -v brew)" ]; then
        echo "Updating HomeBrew"
        run brew update
        #run brew bundle --global check
        #run brew bundle --global install
        run brew upgrade --greedy
        run brew cleanup --prune=all
    fi
}

update_macports() {
    if [ ! -f "/opt/local/bin/port" ]; then
        return
    fi
    if [ -z "$(command -v port)" ]; then
        return
    fi
    echo "updating macports"
    run sudo port selfupdate
    run sudo port upgrade outdated
    run sudo port uninstall inactive
}

update_linuxbrew() {
    if [ -z "$(command -v brew)" ]; then
        return
    fi
    if [ -d "/home/linuxbrew/.linuxbrew" ] || [ -d "$HOME/.linuxbrew" ]; then
        echo "Updating LinuxBrew"
        run brew update
        run brew upgrade
        run brew cleanup --prune=all
    fi
}

update_snap() {
    if [ -d "/snap" ] && [ -n "$(command -v snap)" ]; then
        echo "Updating snap"
        run sudo snap refresh
    fi
}

update_pip() {
    echo "Updating Pip"
    case $OSTYPE in
    linux*)
        if [ -n "$(command -v pip)" ]; then
            pip list --user --format=columns | tail -n +3 | cut -d ' ' -f 1 | run xargs -n1 pip install --user -U
        fi
        ;;
    darwin*)
        if [ -n "$(command -v pip2)" ]; then
            pip2 list --format=columns | tail -n +3 | cut -d ' ' -f 1 | grep -v 'pip' | run xargs -n1 pip2 install -U
        fi
        if [ -n "$(command -v pip3)" ]; then
            pip3 list --format=columns | tail -n +3 | cut -d ' ' -f 1 | grep -v 'pip' | run xargs -n1 pip3 install -U
        fi
        ;;
    esac
}

update_gem() {
    echo "Updating ruby gems"
    if [[ -x "/usr/local/opt/ruby/bin/gem" ]]; then
        run /usr/local/opt/ruby/bin/gem update
    elif [ -n "$(command -v gem)" ]; then
        run gem update
    fi
}

update_go() {
    if [ -n "$(command -v go)" ]; then
        echo "Updating go packages"
        GO111MODULE=off run go get -u all
    fi
}

update_rust() {
    if [ -n "$(command -v rustup)" ]; then
        run rustup update
    fi
    # https://github.com/nabijaczleweli/cargo-update
    if [ -n "$(command -v cargo-install-update)" ]; then
        cargo-install-update install-update -a
    fi
}

update_opencode() {
    # -------------------------------------------------------------------------
    # OpenCode plugin upgrader.
    #
    # OpenCode resolves plugin specs on first install and caches each one as
    # a literal directory under $XDG_CACHE_HOME/opencode/packages/<spec>/.
    # Once cached, it never re-resolves — so "pkg@latest" stays pinned to
    # whatever version was "latest" the first time opencode ran, and git
    # URLs stay pinned to whichever commit HEAD pointed at on first clone.
    # There is no `opencode plugin upgrade` command.
    #
    # OpenCode's own Npm.add() short-circuits when the cache is already
    # populated — it never re-installs an existing entry. So the only way
    # to upgrade a cached plugin is to either delete the cache (force next
    # startup to re-resolve) or to run the install ourselves in place.
    #
    # We use the in-place route: `cd <cache-dir> && bun add --exact
    # <pkg>@<target>`. This uses the same tool (bun) and the same lockfile
    # format that opencode itself uses, and `--exact` keeps the pinned
    # "pkg": "1.2.3" dependency style opencode writes on a clean install.
    #
    # NOTE: `bun update <pkg>` does NOT work here — opencode's cached
    # package.json pins exact versions, and `bun update` only moves within
    # the range declared in package.json, so it is always a silent no-op.
    # `bun add` re-resolves the requested target explicitly.
    #
    # Git specs (`pkg@git+https://...`) cannot be upgraded in place: bun
    # pins git dependencies to a commit hash in bun.lock and neither
    # `bun update` nor `bun add` re-resolves the branch HEAD. For those we
    # always clear the cache so the next opencode startup re-clones.
    #
    # The cache write does NOT affect a running opencode process — its
    # loaded modules stay in memory until restart. If bun isn't available
    # or the add fails (network, conflict), we fall back to clearing the
    # cache (next opencode startup re-resolves and re-fetches). After every
    # bun add we verify the installed version actually matches the target
    # before claiming success.
    #
    # We query `npm view` to detect outdated entries so we don't force an
    # unnecessary upgrade on every plugin at every run. On
    # registry-unreachable we skip silently — never upgrade what we
    # can't verify.
    # -------------------------------------------------------------------------

    # Silent skip when there's nothing to act on. Missing jq / config / cache
    # all bail with no output — this function is part of a broad `update`
    # sweep and must not surface errors for absent optional tooling.
    if ! command -v jq >/dev/null 2>&1; then
        return 0
    fi
    if [ ! -f "$HOME/.config/opencode/opencode.json" ]; then
        return 0
    fi

    local cache_root="$HOME/.cache/opencode/packages"
    if [ ! -d "$cache_root" ]; then
        return 0
    fi

    local plugins
    if ! plugins=$(jq -r '.plugin[]? // empty' "$HOME/.config/opencode/opencode.json" 2>/dev/null); then
        return 0
    fi
    if [ -z "$plugins" ]; then
        return 0
    fi

    # Optional tools: bun for in-place upgrade, npm for version comparison.
    local have_bun=false have_npm=false
    command -v bun >/dev/null 2>&1 && have_bun=true
    command -v npm >/dev/null 2>&1 && have_npm=true

    local spec upgraded=0 cleared=0 up_to_date=0
    while IFS= read -r spec; do
        [ -z "$spec" ] && continue

        # Path-style specs (./foo, ~/bar, file://..., /abs/path) point at
        # source trees opencode resolves at startup. They have no cache entry.
        case "$spec" in
        /* | ./* | ../* | ~/* | file://*) continue ;;
        esac

        # Normalize the cache path the same way opencode does on the JS side:
        # Node's path.join collapses "://" to ":/", so a git spec like
        # "superpowers@git+https://github.com/.../x.git" caches as
        # "<cache>/superpowers@git+https:/github.com/.../x.git" rather than
        # the literal-string form. We replicate that here so [ -d ] and rm
        # resolve to the real directory opencode actually created.
        local cache_path="$cache_root/$(printf '%s' "$spec" | sed 's|://|:/|g')"

        if [ ! -d "$cache_path" ]; then
            continue
        fi

        # Split the spec into package name and version spec, scope-aware:
        #   "pkg"                  → pkg="pkg",  version=""
        #   "pkg@1.2.3"            → pkg="pkg",  version="1.2.3"
        #   "@scope/pkg"           → pkg="@scope/pkg", version=""
        #   "@scope/pkg@latest"    → pkg="@scope/pkg", version="latest"
        #   "pkg@git+https://..."  → pkg="pkg",  version="git+https://..."
        # A naive ${spec%@*} breaks on a bare scoped spec ("@scope/pkg"
        # would yield an empty name), so the leading scope "@" must be
        # skipped before looking for the version separator.
        local pkg version_spec=""
        if [[ "$spec" == @* ]]; then
            local rest="${spec#@}"
            if [[ "$rest" == *@* ]]; then
                pkg="@${rest%@*}"
                version_spec="${rest##*@}"
            else
                pkg="$spec"
            fi
        elif [[ "$spec" == *@* ]]; then
            pkg="${spec%@*}"
            version_spec="${spec##*@}"
        else
            pkg="$spec"
        fi

        local installed_v="?"
        if [ -f "$cache_path/node_modules/$pkg/package.json" ]; then
            installed_v=$(jq -r '.version // "?"' "$cache_path/node_modules/$pkg/package.json" 2>/dev/null)
        fi

        # Git specs: bun pins git dependencies to a commit in bun.lock and
        # neither `bun update` nor `bun add` re-resolves the branch HEAD —
        # in-place upgrade is impossible. Clear the cache so the next
        # opencode startup re-clones at the current HEAD.
        if [[ "$version_spec" == git+* ]]; then
            print_status "Refreshing: $spec (git, installed $installed_v)"
            rm -rf -- "$cache_path"
            cleared=$((cleared + 1))
            continue
        fi

        # Resolve the target version: explicit for pinned specs, registry
        # lookup for "latest" / unspecified. On registry-unreachable skip
        # silently — never upgrade what we can't verify.
        local target=""
        if [ -n "$version_spec" ] && [ "$version_spec" != "latest" ]; then
            target="$version_spec"
        else
            if ! $have_npm; then
                continue
            fi
            target=$(timeout 10 npm view "$pkg" version 2>/dev/null || echo "")
            if [ -z "$target" ]; then
                continue
            fi
        fi

        if [ "$installed_v" = "$target" ]; then
            up_to_date=$((up_to_date + 1))
            continue
        fi

        # Try in-place upgrade via bun first; fall back to cache-clear if
        # bun isn't installed, the add fails, or the result doesn't match
        # the target. `bun update` is useless here (it respects the pinned
        # exact version in the cached package.json and no-ops), so we use
        # `bun add --exact pkg@target` which re-resolves explicitly while
        # keeping opencode's exact-pin dependency style.
        if $have_bun; then
            print_status "Upgrading: $spec ($installed_v → $target)"
            if (cd "$cache_path" && timeout 90 bun add --exact "$pkg@$target" >/dev/null 2>&1); then
                local new_v="?"
                if [ -f "$cache_path/node_modules/$pkg/package.json" ]; then
                    new_v=$(jq -r '.version // "?"' "$cache_path/node_modules/$pkg/package.json" 2>/dev/null)
                fi
                if [ "$new_v" = "$target" ]; then
                    print_success "Upgraded: $spec → $new_v"
                    upgraded=$((upgraded + 1))
                    continue
                fi
                print_info "bun add left $pkg at $new_v (want $target) — falling back to cache clear"
            else
                print_info "bun add failed for $spec — falling back to cache clear"
            fi
        fi

        # Fallback: clear the cache so opencode re-fetches on next startup.
        print_status "Refreshing: $spec ($installed_v → $target)"
        rm -rf -- "$cache_path"
        cleared=$((cleared + 1))
    done <<<"$plugins"

    if [ "$upgraded" -gt 0 ]; then
        print_info "Upgraded $upgraded plugins in-place — restart OpenCode to load new versions"
    fi
    if [ "$cleared" -gt 0 ]; then
        print_info "Cleared $cleared cache entries — restart OpenCode to fetch"
    fi
    if [ "$up_to_date" -gt 0 ] && [ "$upgraded" -eq 0 ] && [ "$cleared" -eq 0 ]; then
        print_success "All $up_to_date OpenCode plugins already up to date"
    fi
}

update_bunx() {
    # bunx internals (verified):
    #   - Each executed spec gets a working dir in TMPDIR:
    #       bunx-<uid>-cowsay@latest/package.json  → {"cowsay": "^1.6.0"}
    #       bunx-<uid>-cowsay@1.5.0/package.json   → {"cowsay": "1.5.0"}
    #       bunx-<uid>-@scope/pkg@latest/package.json
    #     The recorded range preserves intent: ^/~ from @latest, exact
    #     version from a pinned spec.
    #   - Package content lives in bun's global install cache:
    #       <cache>/<pkg>@<version>@@@<n>/   (hardlink source)
    #     Unlike apt's dead .deb archives these are LIVE installations —
    #     clearing them (bun pm cache rm) makes the next opencode MCP
    #     startup pay a full re-download. So we never clear; we:
    #       1. pre-fetch @latest versions of range-tracked tools into the
    #          global cache, so the next bunx run (which re-resolves the
    #          registry every time) finds files already present
    #       2. prune superseded versions of THOSE SAME PACKAGES ONLY —
    #          other packages may be pinned by project bun.lock files
    #   - The TMPDIR working dirs are ephemeral (tmp cleaner / reboot);
    #     the tool list simply reflects recently used bunx tools.
    if [ -z "$(command -v bun)" ] || ! command -v jq >/dev/null 2>&1; then
        return
    fi
    local have_npm=false
    command -v npm >/dev/null 2>&1 && have_npm=true

    # `bun pm cache` prints the real cache path (bunfig/env can relocate
    # it) but requires a package.json in cwd — hence the scratch dir,
    # which doubles as the pre-fetch vehicle below.
    local scratch cache
    scratch="$(mktemp -d)"
    echo '{}' >"$scratch/package.json"
    cache="$(cd "$scratch" && bun pm cache 2>/dev/null)"
    if [ -z "$cache" ] || [ ! -d "$cache" ]; then
        rm -rf -- "$scratch"
        return
    fi

    local tmp_root="${TMPDIR:-/tmp}"
    local uid
    uid="$(id -u)"
    local range_pkgs="" pinned_pvs="" pkgfile pkg range

    while IFS= read -r pkgfile; do
        while IFS=$'\t' read -r pkg range; do
            [ -n "$pkg" ] || continue
            case "$range" in
            "^"* | "~"*)
                case " $range_pkgs " in
                *" $pkg "*) ;;                       # already listed
                *) range_pkgs="$range_pkgs $pkg" ;;
                esac
                ;;
            *)
                pinned_pvs="$pinned_pvs $pkg@$range" # explicit pin — keep
                ;;
            esac
        done < <(jq -r '.dependencies // {} | to_entries[] | "\(.key)\t\(.value)"' "$pkgfile" 2>/dev/null)
    done < <(find "$tmp_root" -maxdepth 3 -type f -path "*/bunx-$uid-*/package.json" 2>/dev/null)

    local warmed=0 pruned=0 warmed_pvs="" latest_v entry v

    # Pre-fetch latest for range-tracked tools (skip if already cached).
    if $have_npm; then
        for pkg in $range_pkgs; do
            latest_v="$(timeout 10 npm view "$pkg" version 2>/dev/null || echo "")"
            [ -z "$latest_v" ] && continue
            if [ -d "$cache" ] && compgen -G "$cache/$pkg@$latest_v@@@*" >/dev/null; then
                warmed_pvs="$warmed_pvs $pkg@$latest_v"
                continue
            fi
            print_status "Pre-fetching: $pkg@$latest_v"
            if (cd "$scratch" && timeout 90 bun add --exact "$pkg@$latest_v" >/dev/null 2>&1); then
                print_success "Cached: $pkg@$latest_v"
                warmed=$((warmed + 1))
                warmed_pvs="$warmed_pvs $pkg@$latest_v"
            fi
        done
    fi

    # Prune superseded versions of touched packages; keep warmed latest
    # and explicitly pinned versions.
    for pkg in $range_pkgs $(printf '%s' "$pinned_pvs" | tr ' ' '\n' | sed 's/@[^@]*$//' | sort -u); do
        for entry in "$cache/$pkg"@*@@@*/; do
            [ -d "$entry" ] || continue
            # basename would strip the @scope/ prefix — strip the full
            # "<cache>/<pkg>@" prefix and the "@@@<n>/" suffix instead.
            v="${entry#"$cache/$pkg"@}"
            v="${v%@@@*/}"
            case " $warmed_pvs$pinned_pvs " in
            *" $pkg@$v "*) continue ;;
            esac
            run rm -rf -- "$entry"
            pruned=$((pruned + 1))
        done
    done
    rm -rf -- "$scratch"

    if [ "$warmed" -gt 0 ]; then
        print_info "Pre-fetched $warmed bunx packages at latest version"
    fi
    if [ "$pruned" -gt 0 ]; then
        print_info "Pruned $pruned superseded bunx cache versions"
    fi
    if [ "$warmed" -eq 0 ] && [ "$pruned" -eq 0 ]; then
        print_success "bunx cache already up to date and clean"
    fi
}

update_npx() {
    # npx caches every executed spec in <npm-cache>/_npx/<content-hash>/
    # and NEVER re-resolves afterwards — `npx pkg@latest` keeps running
    # the first version it ever installed (verified: zero registry
    # requests on cached runs, even with --prefer-online).
    #
    # These are LIVE installs npx executes from, not dead archives, so we
    # upgrade in place rather than clear: the original spec tag is lost
    # (npm exec records the resolved range, e.g. "^1.6.0"), so entries
    # whose recorded range starts with ^ or ~ are moved to @latest via
    # `npm install` inside the cache entry; entries pinned to an exact
    # version signal explicit pin intent and are left alone. The cache
    # stays warm — no re-download penalty on the next npx/MCP startup.
    if [ -z "$(command -v npm)" ] || ! command -v jq >/dev/null 2>&1; then
        return
    fi
    local npm_cache npx_cache
    npm_cache="$(npm config get cache 2>/dev/null)"
    npx_cache="$npm_cache/_npx"
    if [ -z "$npm_cache" ] || [ ! -d "$npx_cache" ]; then
        return
    fi

    local upgraded=0 failed=0
    local entry pkg range
    for entry in "$npx_cache"/*/; do
        [ -f "$entry/package.json" ] || continue
        while IFS=$'\t' read -r pkg range; do
            [ -n "$pkg" ] || continue
            case "$range" in
            "^"* | "~"*) ;;                       # semver range → safe to move
            *) continue ;;                        # exact pin → respect intent
            esac
            if (cd "$entry" && timeout 120 npm install --no-audit --no-fund "$pkg@latest" >/dev/null 2>&1); then
                upgraded=$((upgraded + 1))
            else
                print_error "Failed to upgrade npx cache: $pkg"
                failed=$((failed + 1))
            fi
        done < <(jq -r '.dependencies // {} | to_entries[] | "\(.key)\t\(.value)"' "$entry/package.json" 2>/dev/null)
    done

    if [ "$upgraded" -gt 0 ]; then
        print_info "Refreshed $upgraded npx cache packages to @latest (in place, cache stays warm)"
    fi
    if [ "$failed" -gt 0 ]; then
        print_error "$failed npx cache upgrades failed"
    fi
    if [ "$upgraded" -eq 0 ] && [ "$failed" -eq 0 ]; then
        print_success "npx cache empty or all entries pinned"
    fi
}

update_uvx() {
    # uvx revalidates `pkg@latest` against PyPI on EVERY run (verified:
    # conditional GET per invocation), so versions never go stale — but
    # the run right after a new release pays the wheel download. Pre-
    # refresh each cached tool's @latest environment so the download
    # happens now:
    #     uvx --from <pkg>@latest --refresh --quiet python -c pass
    # `python` exists in every uvx env, so nothing tool-specific is
    # executed (important: MCP servers would otherwise start and hang).
    # --refresh re-resolves and rebuilds the env ONLY when the
    # resolution moved.
    #
    # Cached envs live in <uv-cache>/environments-v2/<interp>/<spec>/.
    # The original spec string is hashed, but @latest and plain `pkg`
    # share one env while pinned specs get their own (verified) — so
    # refreshing @latest never disturbs pinned environments. Tools are
    # identified by dist-info dirs providing console_scripts.
    #
    # Then `uv cache prune` for hygiene. Verified prune behavior: it
    # deletes the ephemeral environments but KEEPS the wheels/archives,
    # so the env rebuild it forces on the next uvx run takes ~2ms
    # (hardlink from cache) — the only real cost anywhere in uvx is the
    # wheel download, which the refresh above has already paid. Order
    # matters: refresh first (download new wheels), prune second.
    if [ -z "$(command -v uv)" ]; then
        return
    fi
    local cache_dir env_root
    cache_dir="$(uv cache dir 2>/dev/null)"
    env_root="$cache_dir/environments-v2"
    local refreshed=0 failed=0 seen="" env dist pkg

    if [ -d "$env_root" ]; then
        for env in "$env_root"/*/*/; do
            [ -d "$env" ] || continue
            for dist in "$env"lib/*/site-packages/*.dist-info; do
                [ -f "$dist/entry_points.txt" ] || continue
                grep -q '^\[console_scripts\]' "$dist/entry_points.txt" || continue
                # "<name>-<version>.dist-info": PEP 440 versions never
                # contain '-', and names have '-' rewritten to '_' — so
                # stripping from the LAST '-' recovers the name, and uv
                # normalizes '_' back to '-' when resolving.
                pkg="$(basename "$dist" .dist-info)"
                pkg="${pkg%-*}"
                [ -n "$pkg" ] || continue
                case " $seen " in
                *" $pkg "*) continue ;;
                *) seen="$seen $pkg" ;;
                esac
                if timeout 120 uvx --from "$pkg@latest" --refresh --quiet python -c "pass" >/dev/null 2>&1; then
                    refreshed=$((refreshed + 1))
                else
                    print_error "Failed to refresh uvx env: $pkg"
                    failed=$((failed + 1))
                fi
            done
        done
    fi

    run uv cache prune

    if [ "$refreshed" -gt 0 ]; then
        print_info "Refreshed $refreshed uvx tools to @latest (wheels cached — next run rebuilds in ms)"
    fi
    if [ "$failed" -gt 0 ]; then
        print_error "$failed uvx refreshes failed"
    fi
    if [ "$refreshed" -eq 0 ] && [ "$failed" -eq 0 ]; then
        print_success "No cached uvx tools to refresh"
    fi
}

self_update() {
    if [ -n "$(command -v yadm)" ]; then
        print_info "Updating ${CYAN}yadm${RESET}"
        run -r 5 yadm pull
        run yadm alt
    fi
    
    print_info "Updating personal git repositories"
    for repo in dotfiles .password-store .gnupg; do
        if [ -d "$HOME/$repo/.git" ]; then
            print_info "  ${CYAN}~/$repo${RESET}"
            cd "$HOME/$repo"
            run -r 5 git pull
            run -r 5 git submodule update --recursive --init
            # run git commit -a -m "daily update"
            run git push
        fi
    done
}

update_vim() {
    echo "updating vim"
    for dir in "$HOME/.vim" "$HOME/.config/vim" "$HOME/.config/nvim"; do
        if [ -d "$dir" ]; then
            cd "$dir" && gitpull
        fi
    done
    # Update LazyVim plugins
    if [ -n "$(command -v nvim)" ] && [ -f "$HOME/.config/nvim/lua/config/lazy.lua" ]; then
        run nvim --headless "+Lazy! sync" +qa
    fi
}

update_emacs() {
    if [ -z "$(command -v emacs)" ]; then
        return
    fi
    if [ -d "$HOME/.config/emacs/.git" ]; then
        cd "$HOME/.config/emacs" && run -r 5 git pull
    fi
    if [ -f "$HOME/.config/emacs/init.el" ]; then
        run -r 5 emacs --batch --debug-init --load ~/.config/emacs/init.el --load ~/.config/emacs/extra/update-emacs.el
    else
        update_doom
    fi
}

update_doom() {
    local DOOMDIR
    if [ -f "$HOME/.config/emacs/bin/doom" ]; then
        DOOMDIR="$HOME/.config/emacs/"
    elif [ -f "$HOME/.emacs.d/bin/doom" ]; then
        DOOMDIR="$HOME/.emacs.d/"
    else
        echo "Cannot find doom emacs config"
        return
    fi
    # Doom Emacs
    echo "updating Doom Emacs on $DOOMDIR"
    cd "$DOOMDIR" || return
    # use git pull insted of doom upgrade
    # to prevent the local repo too much behind
    run git reset --hard origin/develop
    run -r 5 git pull
    run -r 5 git submodule update --recursive --init

    # there's currently a bug that requires to
    # update melpa repo manually and clean
    # straight build cache before refresh
    # if [ -d "$DOOMDIR/.local/straight/repos/melpa" ]; then
    #     cd "$DOOMDIR/.local/straight/repos/melpa"
    #     run -r 5 gitpull
    # fi
    # if [ -f "$DOOMDIR/.local/straight/build-cache.el" ]; then
    #     rm -v "$DOOMDIR/.local/straight/build-cache.el"
    # fi

    #run "$DOOMDIR"/bin/doom -y upgrade
    #run "$DOOMDIR"/bin/doom -y clean
    run -r 5 "$DOOMDIR"/bin/doom -y sync -p -u
    run "$DOOMDIR"/bin/doom -y purge
    run "$DOOMDIR"/bin/doom -y build -r
    # run "$DOMDIR"/bin/doom -y compile -c -p
    run "$DOOMDIR"/bin/doom env -a SSH_AUTH_SOCK
    for _PROJECT in "$HOME"/emacs-distros/*; do
        if [ -d "${_PROJECT}/.git" ]; then
            cd "${_PROJECT}"
            run gitpull
        fi
    done
}

update_optools() {
    local _DIR="work"
    if [ -d "$HOME/${_DIR}" ]; then
        print_info "Updating work projects in ${CYAN}~/${_DIR}${RESET}"
        for _PROJECT in "$HOME/${_DIR}"/*; do
            if [ -d "${_PROJECT}" ]; then
                local project_name
                project_name="$(basename "${_PROJECT}")"
                print_info "  ${CYAN}${project_name}${RESET}"
                
                if [ -f "${_PROJECT}/.git/svn/.metadata" ]; then
                    cd "${_PROJECT}"
                    run git svn fetch
                elif [ -d "${_PROJECT}/.git" ]; then
                    cd "${_PROJECT}"
                    run git pull
                    run git submodule update --remote --recursive
                fi
            fi
        done
    fi
}

update_grafana() {
    if [ -z "$(command -v grafana)" ]; then
        return
    fi
    run sudo grafana cli plugins update-all
}

update_backup() {
    # backup the whole system
    if [ -n "$(command -v systemctl)" ]; then
        if systemctl list-unit-files | grep -qE '\bbackup.service\b'; then
            run sudo systemctl start backup.service
        fi
    fi
}

update_ollama() {
    if [ -n "$(command -v ollama)" ] && systemctl status ollama.service >/dev/null; then
        ollama list | tail -n +2 | awk '{print $1}' | while read -r model; do
            ollama pull "$model"
        done
    fi
}

update_mastodon() {
    if [ -f "/home/mastodon/update.sh" ]; then
        sudo su - mastodon -c 'cd /home/mastodon/ && bash -x update.sh'
    fi
}

print_summary() {
    echo
    echo -e "${BOLD}${BLUE}═══════════════════════════════════════${RESET}"
    echo -e "${BOLD}${BLUE}         UPDATE SUMMARY${RESET}"
    echo -e "${BOLD}${BLUE}═══════════════════════════════════════${RESET}"
    echo
    
    if [ ${#UPDATE_SUCCESS[@]} -gt 0 ]; then
        print_success "Successfully updated (${#UPDATE_SUCCESS[@]}):"
        for component in "${UPDATE_SUCCESS[@]}"; do
            echo -e "  ${GREEN}✓${RESET} $component"
        done
        echo
    fi
    
    if [ ${#UPDATE_FAILED[@]} -gt 0 ]; then
        print_error "Failed updates (${#UPDATE_FAILED[@]}):"
        for component in "${UPDATE_FAILED[@]}"; do
            echo -e "  ${RED}✗${RESET} $component"
        done
        echo
    fi
    
    local total=$((${#UPDATE_SUCCESS[@]} + ${#UPDATE_FAILED[@]}))
    if [ "$total" -gt 0 ]; then
        print_info "Total: ${GREEN}${#UPDATE_SUCCESS[@]} successful${RESET}, ${RED}${#UPDATE_FAILED[@]} failed${RESET} (out of $total)"
    else
        print_info "No updates were tracked."
    fi
    echo
}

# Execute update function and track result
run_update() {
    local func_name="$1"
    local display_name="$2"
    
    print_header "Updating $display_name"
    set +e
    "$func_name"
    local result=$?
    set -e
    track_update "$display_name" "$result"
}

update() {
    if [[ $(uname -o) != "Android" ]]; then
        get_sudo
    fi
    case $OSTYPE in
    linux*)
        run_update self_update "Dotfiles (self)"
        run_update update_zsh "ZSH"
        run_update update_linux_system "Linux System"
        run_update update_linuxbrew "Linuxbrew"
        run_update update_snap "Snap"
        run_update update_vim "Vim"
        run_update update_pip "Pip"
        run_update update_rust "Rust"
        run_update update_emacs "Emacs"
        run_update update_ollama "Ollama"
        run_update update_optools "Optools"
        run_update update_opencode "OpenCode"
        run_update update_bunx "bunx"
        run_update update_npx "npx"
        run_update update_uvx "uvx"
        run_update update_grafana "Grafana"
        run_update update_mastodon "Mastodon"
        ;;
    darwin*)
        run_update self_update "Dotfiles (self)"
        run_update update_zsh "ZSH"
        run_update update_context "ConTeXt"
        run_update update_mac_system "macOS System"
        run_update update_mas "Mac App Store"
        run_update update_homebrew "Homebrew"
        run_update update_macports "MacPorts"
        run_update update_pip "Pip"
        run_update update_gem "Ruby Gems"
        run_update update_rust "Rust"
        run_update update_vim "Vim"
        run_update update_emacs "Emacs"
        run_update update_optools "Optools"
        run_update update_opencode "OpenCode"
        run_update update_bunx "bunx"
        run_update update_npx "npx"
        run_update update_uvx "uvx"
        run_update update_go "Go"
        ;;
    cygwin*)
        print_error "Unsupported OS type: $OSTYPE"
        ;;
    *)
        print_error "Unsupported OS type: $OSTYPE"
        ;;
    esac
    
    # Print summary at the end
    print_summary
}

main() {
    if [ "$#" -eq 0 ]; then
        update
    else
        eval "update_$1"
    fi
}

main "$@"
