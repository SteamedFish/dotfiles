#!/usr/bin/env bash
# update_opencode - invalidate OpenCode plugin cache to force re-fetch on next startup
#
# OpenCode caches plugins at ~/.cache/opencode/packages/<spec>/ and never
# re-checks the registry on its own. Removing the cache entry for each
# configured plugin makes the next `opencode` startup re-resolve the spec
# (e.g. "pkg@latest" re-resolves to the current latest version on npm,
# "git+https://..." re-clones at the default branch).
#
# Usage:
#   update_opencode              # clear all configured plugin caches
#   update_opencode --dry-run    # print planned cache deletions without removing
#   update_opencode -h          # show help

set -o errexit
set -o pipefail
set -o nounset
set -o errtrace

# Color definitions
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly RESET='\033[0m'

print_success() {
    echo -e "${GREEN}✓${RESET} $*"
}

print_error() {
    echo -e "${RED}✗${RESET} $*" >&2
}

print_status() {
    echo -e "${BLUE}→${RESET} $*"
}

print_info() {
    echo -e "${CYAN}ℹ${RESET} $*"
}

print_header() {
    echo -e "\n${BOLD}${BLUE}═══ $* ═══${RESET}\n"
}

# Summary tracking
declare -a UPDATE_SUCCESS=()
declare -a UPDATE_FAILED=()
declare -a UPDATE_SKIPPED=()

# True when we should only print, not mutate.
DRY_RUN=false

usage() {
    cat <<EOF
update_opencode - invalidate OpenCode plugin cache

OpenCode pins plugin specs to literal cache directories and never re-checks
the registry once installed. This script removes the cache entries for every
plugin declared in opencode.json so the next OpenCode startup will re-resolve
each spec (fetch latest version, re-clone git URLs).

Usage:
    update_opencode [--dry-run] [-h]

Options:
    -n, --dry-run    Print planned cache deletions without removing anything
    -h, --help       Show this help
EOF
}

is_path_plugin_spec() {
    # OpenCode treats absolute paths, relative paths, ~/ paths, and file:// URLs
    # as local file plugins — they have no cache entry to invalidate.
    local spec="$1"
    [[ "$spec" == /* || "$spec" == ./* || "$spec" == ../* || "$spec" == ~/* || "$spec" == file://* ]]
}

clear_plugin_cache() {
    local spec="$1"
    local cache_dir="$2"

    if is_path_plugin_spec "$spec"; then
        print_info "Skip (path plugin): $spec"
        UPDATE_SKIPPED+=("$spec")
        return 0
    fi

    # OpenCode builds the cache dir with path.join(cache, packages, spec).
    # On the kernel, "://" collapses to "/", matching path.join normalization,
    # so a plain string concat resolves to the same directory.
    local cache_path="$cache_dir/$spec"
    if [ ! -d "$cache_path" ]; then
        print_info "No cache entry: $spec"
        UPDATE_SKIPPED+=("$spec")
        return 0
    fi

    if $DRY_RUN; then
        print_status "DRY-RUN would remove: $cache_path"
        UPDATE_SUCCESS+=("$spec (dry-run)")
        return 0
    fi

    if rm -rf -- "$cache_path"; then
        print_success "Cleared: $spec"
        UPDATE_SUCCESS+=("$spec")
    else
        print_error "Failed to clear: $spec"
        UPDATE_FAILED+=("$spec")
        return 1
    fi
}

update_opencode() {
    local config_path="${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}"
    local cache_path="${OPENCODE_CACHE:-$HOME/.cache/opencode/packages}"

    print_header "Updating OpenCode plugins"

    if ! command -v jq >/dev/null 2>&1; then
        print_error "jq is required but not installed."
        print_info "Install: sudo apt install jq  (or equivalent)"
        return 1
    fi

    if [ ! -f "$config_path" ]; then
        print_info "No OpenCode config found at $config_path"
        return 0
    fi

    local plugins
    if ! plugins=$(jq -r '.plugin[]? // empty' "$config_path" 2>&1); then
        print_error "Failed to parse $config_path"
        echo "$plugins" >&2
        return 1
    fi

    if [ -z "$plugins" ]; then
        print_info "No plugins configured in $config_path"
        return 0
    fi

    if [ ! -d "$cache_path" ]; then
        print_info "Cache directory does not exist: $cache_path"
        print_info "Plugins will install fresh on next OpenCode startup"
        return 0
    fi

    print_info "Config: $config_path"
    print_info "Cache:  $cache_path"
    echo

    local spec
    while IFS= read -r spec; do
        [ -z "$spec" ] && continue
        clear_plugin_cache "$spec" "$cache_path" || true
    done <<<"$plugins"
}

print_summary() {
    echo
    echo -e "${BOLD}${BLUE}═══════════════════════════════════════${RESET}"
    echo -e "${BOLD}${BLUE}         UPDATE SUMMARY${RESET}"
    echo -e "${BOLD}${BLUE}═══════════════════════════════════════${RESET}"
    echo

    if [ ${#UPDATE_SUCCESS[@]} -gt 0 ]; then
        print_success "Cleared (${#UPDATE_SUCCESS[@]}):"
        for item in "${UPDATE_SUCCESS[@]}"; do
            echo -e "  ${GREEN}✓${RESET} $item"
        done
        echo
    fi

    if [ ${#UPDATE_SKIPPED[@]} -gt 0 ]; then
        print_info "Skipped (${#UPDATE_SKIPPED[@]}):"
        for item in "${UPDATE_SKIPPED[@]}"; do
            echo -e "  ${CYAN}○${RESET} $item"
        done
        echo
    fi

    if [ ${#UPDATE_FAILED[@]} -gt 0 ]; then
        print_error "Failed (${#UPDATE_FAILED[@]}):"
        for item in "${UPDATE_FAILED[@]}"; do
            echo -e "  ${RED}✗${RESET} $item"
        done
        echo
    fi

    local total=$((${#UPDATE_SUCCESS[@]} + ${#UPDATE_SKIPPED[@]} + ${#UPDATE_FAILED[@]}))
    if [ "$total" -gt 0 ]; then
        print_info "Total: ${GREEN}${#UPDATE_SUCCESS[@]} cleared${RESET}, ${CYAN}${#UPDATE_SKIPPED[@]} skipped${RESET}, ${RED}${#UPDATE_FAILED[@]} failed${RESET} (of $total)"
    else
        print_info "No plugins were processed."
    fi
    echo

    if [ ${#UPDATE_SUCCESS[@]} -gt 0 ] && ! $DRY_RUN; then
        print_info "Restart OpenCode to re-resolve plugins and pull updates."
    fi
}

main() {
    while [ $# -gt 0 ]; do
        case "$1" in
        -n | --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            print_error "Unknown option: $1"
            usage >&2
            exit 2
            ;;
        esac
    done

    update_opencode
    print_summary
}

main "$@"