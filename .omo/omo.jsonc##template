          "model": "open-webui/claude-opus-4-6",
          "reasoning": "max"
        },
        "metis": {
          "model": "open-webui/claude-opus-4-6",
          "reasoning": "max"
        },
        "momus": {
          "model": "github-copilot/gpt-5.4",
          "reasoning": "xhigh"
        },
        "atlas": {
