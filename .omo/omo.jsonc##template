// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "disabled_mcps": [
      "websearch",
      "context7",
      "grep_app"
    ],
{% if yadm.class != "work" %}
    "runtime_fallback": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_on_errors": [
        402,
        429,
        503
      ]
    },
{% endif %}
    "agents": {
{% if yadm.class == "work" %}
        "sisyphus": {
          "model": "open-webui/claude-opus-4-6",
          "reasoning": "max"
        },
        "hephaestus": {
          "model": "github-copilot/gpt-5.4",
          "reasoning": "medium"
        },
        "oracle": {
          "model": "github-copilot/gpt-5.4",
          "reasoning": "high"
        },
        "librarian": {
          "model": "github-copilot/claude-sonnet-4.6"
        },
        "explore": {
          "model": "github-copilot/claude-sonnet-4.6"
        },
        "multimodal-looker": {
          "model": "github-copilot/gemini-3-flash-preview"
